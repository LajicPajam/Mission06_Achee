@model Movie
@{
    ViewData["Title"] = "Delete Movie";
}

<h2 class="mb-3">Delete Movie</h2>
<p class="alert alert-warning">Are you sure you want to delete this movie?</p>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Year</dt>
    <dd class="col-sm-10">@Model.Year</dd>

    <dt class="col-sm-2">Director</dt>
    <dd class="col-sm-10">@Model.Director</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
